<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Stage Marine Quotation Automation Suite" verbose="2">
    
    <test name="Quotation Automation Tests" preserve-order="true">
        <classes>
            <class name="com.stagemarine.automation.QuotationAutomationTest">
                <methods>
                    <include name="testCustomerTemplateData"/>
                    <include name="testDifferentQuotationTypes"/>
                    <include name="testQuotationFormFilling"/>
                    <include name="testCompleteQuotationProcess"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <listeners>
        <listener class-name="org.testng.reporters.XMLReporter"/>
        <listener class-name="org.testng.reporters.JUnitReportReporter"/>
    </listeners>
    
</suite>